# Copy this file to .env and fill in your own values. Never commit .env.
#
# Bitget API credentials (create at https://www.bitget.com/en/account/newapi)
# Scope the key to "Futures Trade" only. Do NOT enable withdrawals.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Safety interlock. Must be exactly "true" (lowercase) for the bot to place
# real orders. Anything else keeps you in paper mode even if you pass
# --mode live on the command line.
LIVE_TRADING_ENABLED=false
